# On-Chain SPOT Bot v2 Environment Configuration
APP_NAME=On-Chain SPOT Bot v2
DEFAULT_CHAIN=solana
EXECUTION_MODE=paper
TOTAL_CAPITAL_USD=1000.0
MAX_POSITIONS=5
MAX_POSITION_SIZE_USD=100.0
SELL_COOLDOWN_MINUTES=60
MIN_PRICE_USD=0.00000001
MAX_PRICE_USD=100000.0
WATCH_NEW_PAIRS=true
ENABLE_LIVE_MARKET_DATA=true

# Optional API keys (public free tier is used if left blank)
# Keys are masked in GUI and never logged
GOPLUS_API_KEY=
RUGCHECK_API_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
ETHEREUM_RPC_URL=https://cloudflare-eth.com
BSC_RPC_URL=https://binance.llamarpc.com
BASE_RPC_URL=https://mainnet.base.org
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
POLYGON_RPC_URL=https://polygon-rpc.com
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
OPTIMISM_RPC_URL=https://mainnet.optimism.io
